{
  "name": "sweet-flowers-deco-party",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/deploy-db.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:deploy": "node --env-file=.env.local scripts/deploy-db.mjs --manual",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.10.0",
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.0.1",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "^16.4.5",
    "next-auth": "beta",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
